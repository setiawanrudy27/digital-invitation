"use client";

import { motion } from "framer-motion";
import type { Couple } from "@/components/invite/types";
import { themeColors, FloatingLeaves, OrnamentDivider, RoseOrnament } from "@/components/invite/decoratives";

interface CoupleCardProps {
  person: Couple;
  label: string;
  showPhoto?: boolean;
}

function CoupleCard({ person, label, showPhoto = true }: CoupleCardProps) {
  return (
    <motion.div
      initial={{ opacity: 0, y: 50 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true, amount: 0.3 }}
      transition={{ duration: 0.8, ease: "easeOut" }}
      className="group relative flex flex-col items-center text-center gap-3 py-6 px-4 rounded-2xl"
      style={{
        background: `linear-gradient(180deg, ${themeColors.surface} 0%, ${themeColors.cream} 100%)`,
        border: `1px solid rgba(201,168,76,0.2)`,
        boxShadow: "0 4px 30px rgba(0,0,0,0.05)",
      }}
    >
      {/* Corner decorative roses */}
      <div className="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <RoseOrnament size={16} className="absolute left-1 top-1" />
        <RoseOrnament size={16} className="absolute right-1 top-1" />
        <RoseOrnament size={16} className="absolute left-1 bottom-1" />
        <RoseOrnament size={16} className="absolute right-1 bottom-1" />
      </div>

      {showPhoto && (
        <div className="relative mt-2">
          {/* Oval frame with gold border */}
          <div className="relative w-24 h-32 md:w-28 md:h-36">
            {/* Gold oval frame */}
            <svg className="absolute inset-0 w-full h-full" viewBox="0 0 144 176" fill="none" style={{ zIndex: 2 }} aria-hidden="true">
              <ellipse cx="72" cy="88" rx="68" ry="84" stroke={themeColors.gold} strokeWidth="2" opacity="0.5" />
              <ellipse cx="72" cy="88" rx="62" ry="78" stroke={themeColors.gold} strokeWidth="0.5" opacity="0.2" />
              {/* Ornamental dots on frame */}
              <circle cx="72" cy="6" r="2" fill={themeColors.gold} opacity="0.4" />
              <circle cx="72" cy="170" r="2" fill={themeColors.gold} opacity="0.4" />
              <circle cx="6" cy="88" r="2" fill={themeColors.gold} opacity="0.4" />
              <circle cx="138" cy="88" r="2" fill={themeColors.gold} opacity="0.4" />
            </svg>
            {/* Photo */}
            <div className="absolute inset-2 overflow-hidden rounded-full" style={{ clipPath: "ellipse(50% 50% at 50% 50%)" }}>
              {person.photo_url ? (
                <img src={person.photo_url} alt={person.full_name} className="w-full h-full object-cover" />
              ) : (
                <div className="w-full h-full flex items-center justify-center" style={{ background: `linear-gradient(135deg, ${themeColors.blush}, ${themeColors.surface})` }}>
                  <svg className="w-10 h-10" style={{ color: `${themeColors.secondary}80` }} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1}>
                    <path strokeLinecap="round" strokeLinejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                  </svg>
                </div>
              )}
            </div>
          </div>
        </div>
      )}

      <span className="font-sans text-[10px] uppercase tracking-[0.25em]" style={{ color: themeColors.primary }}>
        {label}
      </span>

      <h3 className="font-display text-xl md:text-2xl italic" style={{ color: themeColors.charcoal }}>
        {person.full_name}
      </h3>

      {person.nickname && (
        <p className="font-sans text-sm -mt-3 italic" style={{ color: themeColors.secondary }}>
          &ldquo;{person.nickname}&rdquo;
        </p>
      )}

      <p className="font-sans text-sm leading-relaxed" style={{ color: themeColors.text }}>
        {person.person_type === "bride" ? "Putri" : "Putra"}
        {person.child_order ? ` ${person.child_order}` : ""} dari
        <br />
        <span className="font-medium" style={{ color: themeColors.primary }}>
          {person.father_name || "-"}
        </span>
        {person.mother_name && (
          <>
            <br />
            <span style={{ color: themeColors.secondary }}>&amp;</span>{" "}
            <span className="font-medium" style={{ color: themeColors.primary }}>
              {person.mother_name}
            </span>
          </>
        )}
      </p>

      {person.instagram_username && (
        <a
          href={`https://instagram.com/${person.instagram_username}`}
          target="_blank" rel="noopener noreferrer"
          className="inline-flex items-center gap-2 transition-colors duration-30"
          style={{ color: themeColors.primary }}
        >
          <svg className="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
          <span className="font-sans text-sm">@{person.instagram_username}</span>
        </a>
      )}
    </motion.div>
  );
}

export default function CoupleSection({ groom, bride, showPhoto = true }: {
  groom: Couple | null;
  bride: Couple | null;
  showPhoto?: boolean;
}) {
  return (
    <section id="couple" className="relative py-12 md:py-16 px-4 overflow-hidden vintage-bg watercolor-overlay"
    >
      <FloatingLeaves />
      <div className="max-w-5xl mx-auto relative z-10">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ duration: 0.6 }}
          className="text-center mb-8"
        >
          
          <h2 className="font-display text-3xl md:text-4xl mt-3 italic" style={{ color: themeColors.charcoal }}>
            Pasangan Mempelai
          </h2>
          <p className="mx-auto mt-3 max-w-xl font-sans text-xs md:text-sm leading-relaxed" style={{ color: themeColors.muted }}>
            Dengan segala puji bagi Allah yang telah menciptakan makhluk-Nya berpasang-pasangan, Yaa Allah izinkanlah kami merangkaikan cinta yang Engkau berikan dalam ikatan pernikahan.
          </p>
          <OrnamentDivider variant="gold" className="mt-6" />
        </motion.div>

        <div className="grid grid-cols-1 items-stretch gap-6">
          {bride && (
            <CoupleCard person={bride} label="Mempelai Wanita" showPhoto={showPhoto} />
          )}

          <div className="flex items-center justify-center gap-3 shrink-0">
            <span className="w-12 h-px" style={{ background: `linear-gradient(90deg, transparent, ${themeColors.gold}, transparent)` }} />
            <span className="font-script text-2xl" style={{ color: themeColors.gold }}>&amp;</span>
            <span className="w-12 h-px" style={{ background: `linear-gradient(90deg, transparent, ${themeColors.gold}, transparent)` }} />
          </div>

          {groom && (
            <CoupleCard person={groom} label="Mempelai Pria" showPhoto={showPhoto} />
          )}
        </div>
      </div>
    </section>
  );
}
